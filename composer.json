{
    "name": "spaanproductions/laravel-status",
    "description": "Sends the versions, packages, scheduled tasks and backups of a Laravel application to the Spaan Productions status dashboard.",
    "keywords": [
        "spaanproductions",
        "laravel",
        "laravel-status",
        "monitoring"
    ],
    "homepage": "https://github.com/spaanproductions/laravel-status",
    "license": "MIT",
    "authors": [
        {
            "name": "Spaan Productions",
            "email": "info@spaanproductions.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "composer-runtime-api": "^2.0",
        "guzzlehttp/guzzle": "^7.11",
        "illuminate/contracts": "^9.21|^10.30|^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.4",
        "symfony/process": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "brianium/paratest": "^6.2|^7.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "nunomaduro/collision": "^5.3|^6.0|^7.0|^8.0",
        "orchestra/testbench": "^7.0|^8.0|^9.2|^10.0|^11.0",
        "phpunit/phpunit": "^9.3|^10.0|^11.0|^12.0|^13.0",
        "spatie/laravel-ray": "^1.36.1",
        "spatie/ray": "^1.43.0"
    },
    "autoload": {
        "psr-4": {
            "SpaanProductions\\LaravelStatus\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SpaanProductions\\LaravelStatus\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "./vendor/bin/testbench package:test --parallel --no-coverage",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "lint": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "fix": "vendor/bin/php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "SpaanProductions\\LaravelStatus\\LaravelStatusServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
